{
  "name": "WhatsApp OCR Pipeline",
  "nodes": [
    {
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "whatsapp-webhook",
        "httpMethod": "POST"
      },
      "position": [240, 300]
    },
    {
      "name": "Extract Media URL",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "media_url",
              "value": "={{$json.entry[0].changes[0].value.messages[0].image.id}}"
            },
            {
              "name": "phone",
              "value": "={{$json.entry[0].changes[0].value.messages[0].from}}"
            }
          ]
        }
      },
      "position": [460, 300]
    },
    {
      "name": "Django Process Document",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{$env.DJANGO_API_URL}}/api/process-document/",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "phone_number", "value": "={{$json.phone}}"},
            {"name": "media_url", "value": "={{$json.media_url}}"}
          ]
        }
      },
      "position": [680, 300]
    },
    {
      "name": "Check Validation Status",
      "type": "n8n-nodes-base.switch",
      "parameters": {
        "dataPropertyName": "status",
        "rules": {
          "rules": [
            {"value": "validated"},
            {"value": "escalated"}
          ]
        }
      },
      "position": [900, 300]
    },
    {
      "name": "Send Success Reply",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$env.WHATSAPP_PHONE_ID}}/messages"
      },
      "position": [1120, 200]
    },
    {
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [240, 500]
    },
    {
      "name": "Notify Dev Team",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$env.WHATSAPP_PHONE_ID}}/messages"
      },
      "position": [460, 500]
    }
  ]
}