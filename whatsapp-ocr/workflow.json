{
  "name": "WhatsApp OCR Pipeline",
  "nodes": [
    {
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "whatsapp-webhook",
        "httpMethod": "POST"
      },
      "position": [240, 300]
    },
    {
      "name": "Extract Media URL",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "media_url",
              "value": "={{$json.entry[0].changes[0].value.messages[0].image.id}}"
            },
            {
              "name": "phone",
              "value": "={{$json.entry[0].changes[0].value.messages[0].from}}"
            }
          ]
        }
      },
      "position": [460, 300]
    },
    {
      "name": "Django Process Document",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{$env.DJANGO_API_URL}}/api/process-document/",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "phone_number", "value": "={{$json.phone}}"},
            {"name": "media_url", "value": "={{$json.media_url}}"}
          ]
        }
      },
      "position": [680, 300]
    },
    {
      "name": "Check Validation Status",
      "type": "n8n-nodes-base.switch",
      "parameters": {
        "dataPropertyName": "status",
        "rules": {
          "rules": [
            {"value": "validated"},
            {"value": "escalated"}
          ]
        }
      },
      "position": [900, 300]
    },
    {
      "name": "Send Success Reply",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$json.phone}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Receipt validated and stored. Reference: {{$json.document_id}}\"\n  }\n}"
      },
      "position": [1120, 200]
    },
    {
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [240, 500]
    },
    {
      "name": "Notify Dev Team",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$env.DEV_CHAT_ID}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Document {{$json.document_id}} escalated. Confidence: {{$json.confidence}}. Review at /api/escalate/ endpoint.\"\n  }\n}"
      },
      "position": [460, 500]
    }
  ],
  "connections": {
    "WhatsApp Trigger": {
      "main": [[{"node": "Extract Media URL", "type": "main", "index": 0}]]
    },
    "Extract Media URL": {
      "main": [[{"node": "Django Process Document", "type": "main", "index": 0}]]
    },
    "Django Process Document": {
      "main": [[{"node": "Check Validation Status", "type": "main", "index": 0}]]
    },
    "Check Validation Status": {
      "main": [
        [{"node": "Send Success Reply", "type": "main", "index": 0}],
        [{"node": "Notify Dev Team", "type": "main", "index": 0}]
      ]
    },
    "Error Trigger": {
      "main": [[{"node": "Notify Dev Team", "type": "main", "index": 0}]]
    }
  }
}